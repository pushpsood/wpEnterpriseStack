{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "inlineSourceMap": true,
    "declaration": false,
    "outDir": "./"
  },
  "include": [
    "lib/**/*"
  ],
  "exclude": [
    "node_modules",
    "cdk.out",
    "test"
  ]
}
